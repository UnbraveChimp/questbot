{
	"$schema": "https://v2-10-7.turborepo.dev/schema.json",
	"envMode": "loose",
	"globalDependencies": [".env", "pnpm-lock.yaml"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"outputs": ["src/generated/**"],
			"cache": true
		},
		"test": {
			"outputs": ["coverage/**"],
			"cache": true
		}
	},
	"remoteCache": {
		"signature": false
	}
}
