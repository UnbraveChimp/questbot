{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "questbot-workspace",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"start": "pnpm --filter @duckorganization/bot start",
		"db:push": "turbo run db:push",
		"db:generate": "turbo run db:generate",
		"prisma": "pnpm --filter @duckorganization/bot prisma",
		"clean": "turbo run build --force && rm -rf node_modules apps/*/node_modules dist .turbo"
	},
	"dependencies": {
		"discord.js": "^14.26.4"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"turbo": "^2.9.16"
	}
}
