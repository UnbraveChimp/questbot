{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "questbot-workspace",
	"version": "0.1.0",
	"private": true,
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.12.0",
			"onFail": "ignore"
		}
	},
	"scripts": {
		"build": "dotenv -e .env -- turbo run build",
		"dev": "dotenv -e .env -- turbo run dev",
		"lint": "dotenv -e .env -- turbo run lint",
		"format": "dotenv -e .env -- turbo run format",
		"start": "pnpm --filter @duckorganization/bot start",
		"db:push": "dotenv -e .env -- turbo run db:push",
		"db:generate": "dotenv -e .env -- turbo run db:generate",
		"prisma": "pnpm --filter @duckorganization/bot prisma",
		"clean": "dotenv -e .env -- turbo run build --force && rm -rf node_modules apps/*/node_modules dist .turbo"
	},
	"dependencies": {
		"discord.js": "^14.27.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"dotenv-cli": "^11.0.0",
		"turbo": "^2.10.6"
	}
}
