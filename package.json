{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "questbot-workspace",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"start": "pnpm --filter @duckorganization/bot start",
		"db:push": "turbo run db:push",
		"db:generate": "turbo run db:generate",
		"prisma": "pnpm --filter @duckorganization/bot prisma",
		"clean": "turbo run build --force && rm -rf node_modules apps/*/node_modules dist .turbo"
	},
	"dependencies": {
		"discord.js": "^14.26.4"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"turbo": "^2.10.2"
	}
}
