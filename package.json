{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "questbot-workspace",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"start": "pnpm --filter @duckorganization/bot start",
		"db:push": "turbo run db:push",
		"db:generate": "turbo run db:generate",
		"prisma": "pnpm --filter @duckorganization/bot prisma",
		"clean": "turbo run build --force && rm -rf node_modules apps/*/node_modules dist .turbo"
	},
	"dependencies": {
		"discord.js": "^14.26.4"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"turbo": "^2.10.5"
	}
}
