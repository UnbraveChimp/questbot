{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@duckorganization/questbot",
	"version": "0.1.5",
	"private": true,
	"type": "module",
	"description": "A Discord bot built with Sapphire framework",
	"license": "AGPL-3.0-or-later",
	"author": "Duck Organization",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/duck-organization/quest-bot.git"
	},
	"main": "./dist/index.js",
	"bin": {
		"questbot": "./dist/sharder.js"
	},
	"files": [
		"dist",
		"prisma/schema.prisma",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rimraf dist && tsc",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"start": "node --env-file-if-exists=../../.env dist/sharder.js",
		"dev": "concurrently \"tsc --noEmit --watch --preserveWatchOutput\" \"tsx watch --conditions development --env-file-if-exists=../../.env src/index.ts\"",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@discordjs/core": "^2.4.0",
		"@questbot/database": "workspace:*",
		"@sapphire/framework": "^5.5.0",
		"@types/ms": "^2.1.0",
		"discord.js": "^14.26.4",
		"ipaddr.js": "^2.4.0",
		"ms": "^2.1.3",
		"sharp": "^0.34.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^25.9.2",
		"concurrently": "^9.2.1",
		"tsx": "^4.22.4",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"imports": {
		"#utils/*": {
			"development": "./src/util/*",
			"default": "./dist/util/*"
		},
		"#lib/*": {
			"development": "./src/lib/*",
			"default": "./dist/lib/*"
		}
	}
}
